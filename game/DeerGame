  0% {
    opacity: .9;
  }
  100% {
    opacity: 0;
  }
}
#rc .rr {
  animation: rin .35s both;
}
#rc .rr:nth-child(3) {
  animation-delay: .08s;
}
#rc .rr:nth-child(4) {
  animation-delay: .16s;
}
#rc .rr:nth-child(5) {
  animation-delay: .24s;
